# Required for photo validation and AI analysis
GEMINI_API_KEY=""

# Frontend deployment URL for the separate backend service.
# Example: https://api.your-domain.com
VITE_API_BASE_URL=""

# GEMINI_MODEL="gemini-2.5-flash"
# AI_TIMEOUT_SECONDS=60
# AI_MAX_ATTEMPTS=2

# Doctor portal login (no default password: login is disabled until this is set)
DOCTOR_USERNAME=""
DOCTOR_PASSWORD=""
# Signs doctor session cookies; set a long random value when running several instances
SECRET_KEY=""

# "production" enables Secure cookies and hides /docs
ENVIRONMENT="development"

# Supabase server-side credentials. Never expose the service-role key to the browser.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Gmail API notifications. The recipient and sender defaults are the clinic Gmail account.
# Put one client_secret*.json file in the root secrets/ directory, then authorize it once
# with `python -m app.gmail_auth` from backend/.
GMAIL_NOTIFICATION_EMAIL="anarvaclinic8@gmail.com"
GMAIL_SENDER_EMAIL="anarvaclinic8@gmail.com"
APP_PUBLIC_URL="https://www.anarvaclinic.com/hair-loss-assessment/"
# GMAIL_CLIENT_SECRETS_FILE="secrets/client_secret.json"
# GMAIL_TOKEN_FILE="secrets/gmail-token.json"
